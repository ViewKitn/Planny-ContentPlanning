      "description": "Destructive confirmation.",
      "html": "<button class=\"ds-button ds-danger\">ลบถาวร</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid #cbd9e3;background:#fff;color:var(--ink,#18374b);border-radius:8px;padding:9px 14px;white-space:nowrap;line-height:1.5;text-decoration:none;font-family:'Noto Sans Thai',sans-serif;font-size:14px;font-weight:500;cursor:pointer}.ds-button:hover{background:#edf4f9}.ds-button:focus-visible{outline:3px solid #77b9df;outline-offset:3px}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{opacity:.55;cursor:wait}.ds-danger{background:#a33e36;border-color:#a33e36;color:#fff}.ds-danger:hover{background:#8b302a}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Standard labeled entry with visible field focus.",
      "html": "<label class=\"ds-field\"><span>ชื่อคอนเทนต์</span><input class=\"ds-input\" placeholder=\"คอนเทนต์ชิ้นถัดไป\"/></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;margin-top:14px;font-family:'Noto Sans Thai',sans-serif;font-size:14px;line-height:1.65}.ds-field>span{font-size:12px;color:#526f83}.ds-input{font:inherit;border:1px solid #cbd9e3;border-radius:8px;padding:9px 12px;background:#fff;color:var(--ink,#18374b);min-width:0;width:100%;caret-color:var(--blue,#215f89)}.ds-input::placeholder{color:#667b8a}.ds-input:focus{border-color:var(--focus,#277fb0);outline:2px solid #c7e3f5;outline-offset:1px}"
    },
    {
      "name": "Selected Navigation",
      "kind": "nav",
      "refersTo": "nav-item-selected",
      "description": "Selected destination within pale sidebar navigation.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item ds-selected\">คอนเทนต์ของฉัน</button><button class=\"ds-nav-item\">ปฏิทินเผยแพร่</button></nav>",
      "css": ".ds-nav{display:grid;gap:6px;background:#e8f1f7;padding:16px}.ds-nav-item{display:flex;align-items:center;gap:11px;width:100%;padding:11px 13px;background:none;border:0;border-radius:9px;text-align:left;color:#456278;font-family:'Noto Sans Thai',sans-serif;font-size:14px;line-height:1.65;font-weight:500;cursor:pointer}.ds-nav-item.ds-selected{background:#215f89;color:#fff}.ds-nav-item:not(.ds-selected):hover{background:#d8e8f2;color:#143e5d}.ds-nav-item:focus-visible{outline:3px solid #77b9df;outline-offset:3px}.ds-nav-item:active{transform:translateY(1px)}"
    },
    {
      "name": "Content Card",
      "kind": "card",
      "refersTo": "content-card",
      "description": "Bordered, actionable writing preview without a resting shadow.",
      "html": "<button class=\"ds-card\"><h3>ไอเดียสำหรับคอนเทนต์ชิ้นถัดไป</h3><p>เป้าหมาย ประเด็น และมุมเล่า</p></button>",
      "css": ".ds-card{display:block;width:100%;text-align:left;border:1px solid #d8e3eb;border-radius:12px;background:#fff;color:var(--ink,#18374b);padding:16px 14px 12px;font-family:'Noto Sans Thai',sans-serif;font-size:14px;line-height:1.65;cursor:pointer;transition:border-color .16s,background .16s}.ds-card:hover{border-color:#79a9c9;background:#fbfdff}.ds-card:focus-visible{outline:3px solid #77b9df;outline-offset:3px}.ds-card:active{transform:translateY(1px)}.ds-card h3{font-size:14px;font-weight:600;line-height:1.7;margin:0 0 8px;overflow-wrap:anywhere}.ds-card p{font-size:11px;margin:0;color:var(--muted,#597082);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}"
    },
    {
      "name": "Draft Badge",
      "kind": "chip",
      "refersTo": "status-draft",
      "description": "Noninteractive visible lifecycle label.",
      "html": "<span class=\"ds-badge\">Draft</span>",
      "css": ".ds-badge{display:inline-block;color:#765199;background:#eee7f5;border-radius:5px;font-size:11px;line-height:1.65;padding:3px 8px;font-family:Manrope,sans-serif}"
    },
    {
      "name": "Subtle Button",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "Quiet supporting action with a pale hover ground.",
      "html": "<button class=\"ds-subtle\">กลับไปคอนเทนต์ของฉัน</button>",
      "css": ".ds-subtle{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;background:transparent;color:#456278;border-radius:8px;padding:9px 14px;white-space:nowrap;line-height:1.5;font-family:'Noto Sans Thai',sans-serif;font-size:14px;font-weight:500;cursor:pointer}.ds-subtle:hover{background:#e4eef5}.ds-subtle:focus-visible{outline:3px solid #77b9df;outline-offset:3px}.ds-subtle:active{transform:translateY(1px)}.ds-subtle:disabled{opacity:.55;cursor:wait}"
    }
  ],
  "narrative": {
    "northStar": "Glacier workspace",
    "overview": "Planny is a Thai, Light Mode, Modern SaaS workspace with a glacier blue canvas, maritime blue navigation and white work surfaces. Its character is calm, readable and practical: compact controls organize content while the editor gives writing generous space.\n\nNoto Sans Thai carries interface text and prose. Manrope distinguishes the wordmark and English lifecycle labels. Color helps recognize the shared lifecycle, while visible names and Thai explanations make each stage understandable.",
    "keyCharacteristics": [
      "Thai text with comfortable line height.",
      "Pale blue surroundings and white work surfaces.",
      "Restrained borders and rounded controls.",
      "Five labeled lifecycle colors.",
      "Desktop first, with horizontally scrollable board lanes on mobile."
    ],
    "rules": [
      {
        "name": "The Labeled Stage Rule",
        "body": "Pair lifecycle color with its visible English name; use Thai explanation where the board or selector provides context.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve Noto Sans Thai for Thai text and its comfortable line height.",
      "Do use maritime blue for primary actions and selected navigation.",
      "Do keep lifecycle names visible alongside their colors.",
      "Do give writing more space than supporting controls.",
      "Do preserve visible keyboard focus and the reduced-motion override."
    ],
    "donts": [
      "Don't replace the confirmed Light Mode glacier canvas with a dark interface.",
      "Don't use color alone to communicate lifecycle status.",
      "Don't add resting shadows to every content card.",
      "Don't squeeze the five mobile board lanes into illegible narrow columns."
    ]
  }
}
